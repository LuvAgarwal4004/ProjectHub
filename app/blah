        await res.json();



      if (!res.ok) {

        throw new Error(

          data.error ||

            "Could not save file"

        );

      }



      setHasError(false);



      setErrorDescription("");



      setErrorStartLine("");



      setErrorEndLine("");



      onUpdated(data.file);

    } catch (err) {

      setError(err.message);

    } finally {

      setSaving(false);

    }

  }



  return (

