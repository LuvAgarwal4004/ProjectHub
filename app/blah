        cloudinaryError
      );

      return NextResponse.json(
        {
          error:
            "Could not delete file from storage",
        },
        { status: 500 }
      );
    }

    await file.deleteOne();

    return NextResponse.json({
      success: true,
    });
  } catch (error) {
