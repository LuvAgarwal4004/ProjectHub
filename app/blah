========================= */

export async function DELETE(
  request,
  { params }
) {
  try {
    const { id, fileId } =
      await params;

    const session =
      await getServerSession(
        authOptions
      );

    if (!session?.user?.id) {
      return NextResponse.json(
        {
          error: "Unauthorized",
        },
        { status: 401 }
      );
    }

    await connectDB();

    const membership =
      await getMembership(
        id,
        session.user.id
      );

    if (
      !membership ||
      !["admin", "editor"].includes(
        membership.member.role
      )
    ) {
      return NextResponse.json(
        {
          error:
